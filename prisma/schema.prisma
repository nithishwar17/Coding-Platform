generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  password      String?
  emailVerified DateTime?
  image         String?
  xp            Int          @default(0)
  streak        Int          @default(0)
  lastActive    DateTime     @default(now())
  submissions   Submission[]
  accounts      Account[]
  sessions      Session[]
  solutionPosts SolutionPost[]
  upvotes       Upvote[]
}

model Problem {
  id          Int          @id @default(autoincrement())
  title       String
  difficulty  String
  description String
  tags        String
  testCases   TestCase[]
  starterCode   String?      // JSON stringified map of language -> boilerplate
  submissions   Submission[]
  solutionPosts SolutionPost[]
  studyPlans    StudyPlanProblem[]
}

model Submission {
  id            String   @id @default(cuid())
  code          String
  language      String
  status        String   // e.g., "Accepted", "Wrong Answer"
  executionTime Float?   // in milliseconds
  memoryKb      Float?   // in kilobytes
  createdAt     DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  problemId Int
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  solutionPost SolutionPost?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TestCase {
  id             Int      @id @default(autoincrement())
  input          String   // JSON string of inputs
  expectedOutput String   // JSON string of expected output
  isHidden       Boolean  @default(false)
  
  problemId      Int
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model SolutionPost {
  id          String   @id @default(cuid())
  title       String
  description String?
  
  submissionId String  @unique // A solution is tied to a specific accepted submission
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  problemId   Int
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  upvotes     Upvote[]
}

model Upvote {
  id             String   @id @default(cuid())
  
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  solutionPostId String
  solutionPost   SolutionPost @relation(fields: [solutionPostId], references: [id], onDelete: Cascade)
  
  @@unique([userId, solutionPostId])
}

model StudyPlan {
  id          String   @id @default(cuid())
  title       String
  description String
  slug        String   @unique
  problems    StudyPlanProblem[]
}

model StudyPlanProblem {
  id          String   @id @default(cuid())
  
  studyPlanId String
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  
  problemId   Int
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  
  order       Int      @default(0)
  
  @@unique([studyPlanId, problemId])
}
